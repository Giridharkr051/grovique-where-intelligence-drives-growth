# GROVIQUE LIVE - Environment Configuration Reference
# Duplicate this file as `.env` for custom local runtime variables.

PORT=3000
NODE_ENV=production

# Google Gemini API Key (Optional - for Gemini AI Co-Pilot, RAG Embeddings & Multi-Agent Swarm)
GEMINI_API_KEY=

# Groww Trade API Credentials (Optional - for Live Demat Broker Gateway)
GROWW_API_KEY=
GROWW_API_SECRET=
GROWW_API_TOKEN=

# Market Data Polling & Refresh Rates (in milliseconds)
TICK_INTERVAL_MS=1000
CACHE_TTL_SECONDS=60
